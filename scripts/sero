#!/usr/bin/env bash
# Run the Sero CLI from a checkout without installing the package.
#
# Sero's Python is run as tooling, not built into a distributable (see
# pyproject.toml `package = false`), so this wrapper puts src/ on the path and
# invokes the module. From the repo root:
#
#   scripts/sero plan  --phase team-onboarding --cluster team-a --oidc-discovery-url URL
#   scripts/sero apply --phase root-config --jwt-discovery-url URL   # dry-run
#   scripts/sero apply --phase root-config --jwt-discovery-url URL --apply
#
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="${repo_root}/src${PYTHONPATH:+:${PYTHONPATH}}"
exec python -m sero "$@"
