# Ladon .gitignore
# Secrets hygiene is a first-class rule. Ladon never stores secret values.
# The patterns below are a safety net, not a substitute for the CI check
# that no secret material is committed. Do not rely on this alone.

# --- Secret material (never commit) ---
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der
id_rsa
id_ed25519
*.kubeconfig
kubeconfig
*-credentials.json
*_credentials.json
credentials.json
service-account*.json
sa-*.json
*.tfvars
!example.tfvars
!*.example.tfvars
*.auto.tfvars
.env
.env.*
!.env.example
*.unseal
*.unseal-keys
unseal-keys*
root-token*
vault-token*
bao-token*
.bao-token
.vault-token

# --- Terraform ---
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Helm ---
charts/*.tgz
*/charts/*.tgz
.helm/

# --- Language runtimes / build (placeholders for when code lands) ---
# Node / TypeScript
node_modules/
dist/
build/
*.tsbuildinfo
.npm/
.pnpm-store/
# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
# Go
bin/
vendor/

# --- Editors / OS ---
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# --- Local agent / tooling state ---
.claude/settings.local.json
